// Read the shared volume; no Docker socket access is needed.
loki.source.file "api" {
  targets = [{__path__ = "/var/log/node-api/app.log", service_name = "node-api"}]
  forward_to = [loki.process.api.receiver]
}

loki.process "api" {
  stage.json {
    expressions = {level = "level", timestamp = "timestamp"}
  }
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }
  stage.labels {
    values = {level = ""}
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
